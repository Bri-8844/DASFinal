@model GestionFTTH.Web.Models.Tarea

@{
    ViewData["Title"] = "Editar tarea";
}

<div class="container-fluid">

    <div class="mb-4">
        <h2 class="fw-bold mb-1" style="color:#12395e;">
            Editar tarea
        </h2>

        <p class="text-muted">
            Actualice la información de la tarea @Model.Codigo
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-controller="Tareas"
                  asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">

                <input type="hidden" asp-for="Id" />

                <partial name="_FormularioTarea" model="Model" />

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-controller="Tareas"
                       asp-action="Details"
                       asp-route-id="@Model.Id"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        Guardar cambios
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
