@* Mensajes de confirmación / error comunes a todos los módulos (TempData) *@
@{
    var exito = TempData["MensajeExito"] as string ?? TempData["Mensaje"] as string;
    var error = TempData["MensajeError"] as string;
}

@if (!string.IsNullOrEmpty(exito))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @exito
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
