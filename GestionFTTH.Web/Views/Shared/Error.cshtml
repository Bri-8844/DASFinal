@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center py-5">
    <h2 class="text-danger">Ocurrió un error al procesar la solicitud.</h2>
    <p class="text-muted">
        Intente nuevamente. Si el problema continúa, comuníquese con el administrador del sistema.
    </p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">
            Código de referencia: <code>@Model.RequestId</code>
        </p>
    }

    <a href="~/" class="btn btn-primary">Ir al inicio</a>
</div>
