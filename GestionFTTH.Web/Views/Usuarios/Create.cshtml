@model GestionFTTH.Web.Models.CrearUsuarioViewModel

@{
    ViewData["Title"] = "Nuevo usuario";
}

<div class="container-fluid">

    <div class="mb-4">
        <h2 class="fw-bold" style="color:#12395e;">
            Nuevo usuario
        </h2>

        <p class="text-muted">
            Registro de cuentas de acceso a GestiónFTTH
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-controller="Usuarios"
                  asp-action="Create"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row g-3">

                    <!-- Correo electrónico -->
                    <div class="col-md-12">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="ejemplo@correo.com" autocomplete="off" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <!-- Contraseña -->
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <input asp-for="Password" class="form-control" autocomplete="new-password" />
                        <small class="text-muted">Mínimo 6 caracteres, con mayúscula, minúscula, número y símbolo.</small>
                        <span asp-validation-for="Password" class="text-danger d-block"></span>
                    </div>

                    <!-- Confirmar contraseña -->
                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>

                    <partial name="_OpcionesRolTrabajador"
                             view-data='new ViewDataDictionary(ViewData) { { "Rol", Model.Rol }, { "TrabajadorId", Model.TrabajadorId } }' />

                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-controller="Usuarios"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        Guardar usuario
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
