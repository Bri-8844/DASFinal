@model GestionFTTH.Web.Models.EditarUsuarioViewModel

@{
    ViewData["Title"] = "Editar usuario";
}

<div class="container-fluid">

    <div class="mb-4">
        <h2 class="fw-bold" style="color:#12395e;">
            Editar usuario
        </h2>

        <p class="text-muted">
            Actualice el correo, el rol, el trabajador vinculado o la contraseña.
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-controller="Usuarios"
                  asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row g-3">

                    <div class="col-md-12">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" autocomplete="off" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <partial name="_OpcionesRolTrabajador"
                             view-data='new ViewDataDictionary(ViewData) { { "Rol", Model.Rol }, { "TrabajadorId", Model.TrabajadorId } }' />

                    <div class="col-md-6">
                        <label asp-for="NuevaPassword" class="form-label fw-semibold"></label>
                        <input asp-for="NuevaPassword" class="form-control" autocomplete="new-password" />
                        <small class="text-muted">Déjela vacía para mantener la contraseña actual.</small>
                        <span asp-validation-for="NuevaPassword" class="text-danger d-block"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ConfirmarNuevaPassword" class="form-label fw-semibold"></label>
                        <input asp-for="ConfirmarNuevaPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmarNuevaPassword" class="text-danger"></span>
                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-controller="Usuarios"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        Guardar cambios
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
